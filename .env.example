# Provider and model as pydantic-ai names them (google, openrouter, openai, anthropic, ...),
# and one API key for that provider. Gemini Flash is free at ai.google.dev.
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
# Optional: a larger model for the LLM judges, and the pause between consecutive calls
# LLM_JUDGE_MODEL=gemini-3.5-flash
# LLM_PAUSE_SECONDS=4
